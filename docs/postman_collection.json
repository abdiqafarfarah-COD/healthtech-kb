{
  "info": {
    "name": "Healthtech Knowledge Base API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api/v1" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Amina Hassan\",\n  \"email\": \"amina@example.com\",\n  \"password\": \"SecurePass123\",\n  \"department\": \"Radiology\"\n}"
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"grace@example.com\",\n  \"password\": \"AdminPass123\"\n}"
        }
      }
    },
    {
      "name": "Articles - List (Published)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/articles"
      }
    },
    {
      "name": "Articles - Get by Slug",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/articles/how-to-reset-a-patient-record"
      }
    },
    {
      "name": "Articles - Create (Editor/Admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{base_url}}/articles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Sample Article\",\n  \"content\": \"Article body here\",\n  \"category_id\": 1\n}"
        }
      }
    },
    {
      "name": "Articles - Publish (Admin)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/articles/1/publish"
      }
    },
    {
      "name": "Categories - Create (Admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{base_url}}/categories",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Billing and Payments\",\n  \"description\": \"Articles related to invoicing and billing disputes.\"\n}"
        }
      }
    },
    {
      "name": "Categories - List",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/categories"
      }
    },
    {
      "name": "Search",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/search?q=patient"
      }
    },
    {
      "name": "Feedback - Submit",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{base_url}}/feedback",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"article_id\": 1,\n  \"rating\": 5,\n  \"comment\": \"Very helpful\"\n}"
        }
      }
    },
    {
      "name": "Chat - Ask Question",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/chat",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"How do I reset a patient record?\",\n  \"session_id\": \"abc-123\"\n}"
        }
      }
    },
    {
      "name": "Admin - Dashboard",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/admin/dashboard"
      }
    }
  ]
}